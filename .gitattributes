* text=auto

*.md text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.rs text eol=lf
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

*.png binary
*.ico binary
*.exe binary
*.dll binary
*.pyd binary
*.zip binary
*.7z binary

# Byte-pinned bundled runtimes must survive Git add/checkout unchanged.
runtime/python/** -text -eol
runtime/coding-tools-mcp/** -text -eol
runtime/tunnel-client/** -text -eol
