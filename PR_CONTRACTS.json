{
  "schema_version": 13,
  "rules": {
    "paths_are_repo_relative": true,
    "unlisted_write_is_forbidden": true,
    "must_stop_after_acceptance": true,
    "live_external_tests_only": [
      "LB-000",
      "LB-019"
    ],
    "elevation_has_no_ttl": true,
    "elevation_requires_explicit_user_uac": true,
    "whole_app_elevation_forbidden": true,
    "target_platform": "windows-11-x86_64",
    "external_python_dependency": false,
    "runtime_self_update": false,
    "application_auto_update_v0_1": false,
    "telemetry": false,
    "webview2_bundled": false,
    "generic_elevated_exec": true,
    "user_facing_language": "zh-CN",
    "unnecessary_english_ui_forbidden": true,
    "architecture_rules_file": "ARCHITECTURE_RULES.json",
    "compatibility_baseline_file": "COMPATIBILITY_BASELINE.json",
    "versioned_persistence_required": true,
    "release_sbom_required": true,
    "stable_adapter_required": true,
    "strict_pr_sequence": true,
    "governance_write_exception": {
      "paths": [
        "PR_INDEX.json",
        "PROJECT_STATE.json"
      ],
      "allowed_only_after_acceptance": true,
      "allowed_mutations": [
        "current PR status",
        "next sequential PR status",
        "current_pr pointer",
        "project phase/release readiness"
      ]
    },
    "dependency_manifest_write_exception": {
      "paths": [
        "src-tauri/Cargo.toml",
        "src-tauri/Cargo.lock",
        "package.json",
        "package-lock.json"
      ],
      "condition": "only minimal dependencies required by the current PR; lockfiles must stay synchronized"
    },
    "dashboard_current_task_status": "single_ephemeral_projection",
    "activity_feed_forbidden": true,
    "task_history_ui_forbidden": true,
    "task_summary_redaction_required": true,
    "current_task_inline_only": true,
    "current_task_section_title_forbidden": true,
    "current_task_field_labels_forbidden": true,
    "active_indicator": "green_pulse",
    "reduced_motion_required": true,
    "runtime_api_key_plaintext_forbidden": true,
    "runtime_api_key_cli_forbidden": true,
    "workspace_registry_is_not_authorization_set": true,
    "max_active_workspace_roots": 1,
    "workspace_remove_filesystem_delete_forbidden": true,
    "mcp_workspace_registry_mutation_forbidden": true,
    "group_review_gate_required": true,
    "next_group_requires_previous_adversarial_pass": true,
    "group_review_code_write_forbidden": true,
    "group_review_governance_write_paths": [
      "PR_INDEX.json",
      "PROJECT_STATE.json"
    ],
    "auto_reconnect_enabled": true,
    "auto_reconnect_attempts": 5,
    "auto_reconnect_backoff_seconds": [
      1,
      2,
      5,
      10,
      30
    ],
    "reconnect_ui_before_exhaustion": "forbidden_as_new_ui",
    "reconnect_exhaustion_error_window": true,
    "reconnect_error_window_once_per_generation": true,
    "ui_visual_dependency_additions_forbidden": true,
    "apple_inspired_ui_native_css_only": true,
    "onboarding_screen_count": 5,
    "onboarding_screen_6_forbidden": true,
    "onboarding_screen_5_auto_advance_forbidden": true,
    "onboarding_screen_5_confirm_requires_all_green": true,
    "brand_icon_frozen": true,
    "brand_icon_png": "assets/icons/localbridge.png",
    "brand_icon_ico": "assets/icons/localbridge.ico",
    "brand_icon_replacement_requires_explicit_contract": true,
    "third_party_icon_library_for_branding_forbidden": true
  },
